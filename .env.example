# ==========================================================
# 1. STORE & PREVIEW CONFIGURATION
# ==========================================================
# Project or Client Name
# Example: PROJECT_NAME="My-Brand-Store"
PROJECT_NAME=""

# Live Store Domain / Admin URL
# Example: SHOPIFY_STORE_URL="https://my-brand.myshopify.com"
SHOPIFY_STORE_URL=""

# Preview Theme ID (Numeric ID from Store Admin -> Themes)
# Example: SHOPIFY_THEME_ID="123456789012"
SHOPIFY_THEME_ID=""

# Storefront Password (If the store has an active password gate)
# Example: SHOPIFY_STOREFRONT_PASSWORD="storefrontpassword123"
SHOPIFY_STOREFRONT_PASSWORD=""

# Is Storefront Password-Protected? (true or false)
# Example: PASSWORD_PROTECTED="false"
PASSWORD_PROTECTED="false"

# Full Direct Preview URL (With theme preview parameters)
# Example: PREVIEW_URL="https://my-brand.myshopify.com/?preview_theme_id=123456789012"
PREVIEW_URL=""

# Base Store URL fallback
# Example: PREVIEW_BASE_URL="https://my-brand.com"
PREVIEW_BASE_URL=""

# ==========================================================
# 2. FIGMA DESIGN ACCESS (Dual-Mode: Token or Zero-Token)
# ==========================================================
# Full Figma Design URL for the file/artboard
# Example: FIGMA_URL="https://www.figma.com/design/XXXXX/Brand-Design?node-id=0-1&m=dev"
FIGMA_URL=""

# Personal Figma Access Token (Leave EMPTY for Zero-Token / View-Only console extraction mode)
# Example: FIGMA_ACCESS_TOKEN="figd_abcdef123456_your_token_here"
FIGMA_ACCESS_TOKEN=""

# Figma Data Source ('offline' to run against saved snapshots, 'live' during live fetch)
# Example: FIGMA_SOURCE="offline"
FIGMA_SOURCE="offline"

# ==========================================================
# 3. CLICKUP BUG TRACKING INTEGRATION
# ==========================================================
# ClickUp Personal API Token (from ClickUp Settings -> Apps -> API Token)
# Example: CLICKUP_API_TOKEN="pk_12345678_abcdef"
CLICKUP_API_TOKEN=""

# ClickUp Target List ID (from ClickUp URL: https://app.clickup.com/1234567/v/li/901802345678)
# Example: CLICKUP_LIST_ID="901802345678"
CLICKUP_LIST_ID=""
